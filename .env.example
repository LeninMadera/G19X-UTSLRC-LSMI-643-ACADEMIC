# ============================================================
#  Configuracion del entorno - Espejo publico del .env
#  Copia este archivo a .env y completa tus valores reales.
#  NUNCA subas el .env a GitHub.
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gobierno_datos_ia
DB_USER=root
DB_PASS=

# --- Inteligencia Artificial (OpenAI-compatible: OpenAI, Groq, ...) ---
# Proveedor por defecto de OpenAI. Para usar Groq (clave gratuita):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-20b   (soporta JSON mode)
# Deja AI_API_KEY vacio mientras no tengas clave; el modulo de IA se
# desactiva automaticamente cuando esta en blanco.
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
AI_BASE_URL=https://api.openai.com/v1

# --- Cifrado de sesiones ---
# Genera una con: php -r "echo bin2hex(random_bytes(16));"
APP_KEY=

# --- URL base del proyecto (para enlaces absolutos) ---
# Ej: http://localhost/gobierno-datos-ia
APP_URL=http://localhost/gobierno-datos-ia

# --- Modo depuracion ---
# 1 solo para desarrollo (muestra errores), 0 en produccion.
APP_DEBUG=0

# --- Integracion con fuentes externas (consumo REST/JSON) ---
# Llamadas por GET con validacion anti-SSRF y tamano maximo limitado.
# INTEGRACION_PERMITIR_LOCALHOST habilita hosts locales/privados SOLO
# para pruebas con un mock local (el harness E2E lo pasa por variable
# de entorno, sin editar este archivo).
INTEGRACION_TIMEOUT=15
INTEGRACION_CONNECT_TIMEOUT=5
INTEGRACION_MAX_BYTES=1048576
INTEGRACION_PERMITIR_LOCALHOST=false