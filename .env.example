# ============================================================
#  Plantilla de configuracion del entorno (archivo de ejemplo).
#
#  USO: copia este archivo a .env y completa con TUS valores.
#       Windows PowerShell:  Copy-Item .env.example .env
#       Linux/macOS:         cp .env.example .env
#
#  IMPORTANTE:
#   - Este archivo SOLO lleva valores de ejemplo o vacios.
#   - NO escribas claves, contrasenas ni APP_KEY reales aqui.
#   - El archivo .env es configuracion LOCAL: no se sube a GitHub
#     y no se incluye en las entregas (ZIP) del proyecto.
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gobierno_datos_ia
DB_USER=root
# Contrasena de MySQL en tu equipo. Dejala vacia solo si tu MySQL
# local no la pide.
DB_PASS=

# --- Inteligencia Artificial (cualquier API compatible con OpenAI) ---
# Proveedor por defecto de OpenAI. Para usar Groq (capa gratuita):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-20b   (soporta JSON mode)
# Formatos habituales de clave: sk-... (OpenAI) o gsk_... (Groq).
# Deja AI_API_KEY vacio mientras no tengas clave; el modulo de IA entra
# automaticamente en MODO SIMULADO y funciona sin consumir tokens.
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
AI_BASE_URL=https://api.openai.com/v1

# --- Clave de aplicacion (OPCIONAL, reservada para uso futuro) ---
# En este proyecto APP_KEY se carga en config/app.php pero NO se usa en
# ningun proceso: las sesiones arrancan con session_start() y las
# contrasenas se guardan con password_hash() (que genera su propio salt).
# Puedes dejarla vacia sin que nada falle. Si mas adelante se usa para
# cifrar sesiones o firmar datos, genera un valor unico con:
#   php -r "echo bin2hex(random_bytes(16));"
APP_KEY=

# --- URL base del proyecto (para enlaces absolutos) ---
# Ej: http://localhost/gobierno-datos-ia
APP_URL=http://127.0.0.1:8000

# --- Modo depuracion ---
# 1 solo para desarrollo (muestra errores), 0 en produccion.
APP_DEBUG=0

# --- Integracion con fuentes externas (consumo REST/JSON) ---
# Llamadas por GET con validacion anti-SSRF y tamano maximo limitado.
# INTEGRACION_PERMITIR_LOCALHOST habilita hosts locales/privados SOLO
# para pruebas con un mock local (el harness E2E lo pasa por variable
# de entorno, sin editar este archivo).
INTEGRACION_TIMEOUT=15
INTEGRACION_CONNECT_TIMEOUT=5
INTEGRACION_MAX_BYTES=1048576
INTEGRACION_PERMITIR_LOCALHOST=false

# ============================================================
#  Fin de la plantilla. No anadas claves reales a este archivo.
# ============================================================
