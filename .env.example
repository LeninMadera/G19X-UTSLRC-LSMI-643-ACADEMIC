# ============================================================
#  Configuracion del entorno - Espejo publico del .env
#  Copia este archivo a .env y completa tus valores reales.
#  NUNCA subas el .env a GitHub.
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gobierno_datos_ia
DB_USER=root
DB_PASS=

# --- Inteligencia Artificial (OpenAI) ---
# Dejalo vacio mientras no tengas clave; el modulo de IA se
# desactiva automaticamente cuando esta en blanco.
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# --- Cifrado de sesiones ---
# Genera una con: php -r "echo bin2hex(random_bytes(16));"
APP_KEY=

# --- URL base del proyecto (para enlaces absolutos) ---
# Ej: http://localhost/gobierno-datos-ia
APP_URL=http://localhost/gobierno-datos-ia